# Copy to .env (never commit it). From https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: "off" to run personal mode only (no Message Content intent needed)
WARD_SERVER_MODE=
# Optional: "off" to read with the word lists only (no Ward Lite)
WARD_LITE=
# Optional: minutes between nudges to the same sender (default 10) and check-ins on the same
# person (default 60). Set both to 0 while testing, or Ward goes quiet after the first one.
WARD_NUDGE_MINUTES=
WARD_CHECKIN_MINUTES=
# Optional: Gemma on this machine (through Ollama) takes a second look, with the messages around
# it, at anything only Ward Lite flagged. gemma4:e4b may clear false alarms; other models only
# confirm (see eval/secondlook). WARD_OLLAMA_URL defaults to http://127.0.0.1:11434.
WARD_GEMMA_MODEL=
WARD_OLLAMA_URL=
